.row.pending .dot{animation:pulse 1s infinite alternate}
@keyframes pulse{to{opacity:.25}}
@media(prefers-reduced-motion:reduce){.row.pending .dot{animation:none}}
.nm{font-weight:600}
.meta{color:var(--mute);font-size:13px}
.row.missing .nm{color:var(--mute);font-weight:500}
a.open{color:var(--mark);font-weight:600;text-decoration:none;font-size:14px}
a.open:hover{text-decoration:underline}
.empty{color:var(--mute);padding:36px 8px;text-align:center}
.foot{margin-top:28px;color:var(--mute);font-size:13px;max-width:70ch}
</style></head>
<body><div class="wrap">
<h1>Handle Hunt</h1>
<p class="sub">Find where a username has a public profile. Pick the sites, run the check, open what turns up.</p>
<div class="grid">
  <section class="panel" aria-label="Search setup">
    <label class="big" for="q">Username or Gmail address</label>
    <div class="field">
      <input id="q" type="text" placeholder="e.g. ninja_42 or ninja_42@gmail.com" autocomplete="off" spellcheck="false">
      <button class="go" id="go">Search</button>
    </div>
    <p class="hint" id="hint">For an email, only the part before the @ is used as the handle.</p>
    <div id="cats"></div>
  </section>
  <section class="panel" aria-live="polite" aria-label="Results">
    <div class="bar">
      <div class="tally" id="tally">No search yet</div>
      <div class="tools">
        <label><input type="checkbox" id="hide"> Hide not found</label>
        <button id="csv" disabled>Export CSV</button>
      </div>
    </div>
    <div class="prog"><i id="prog"></i></div>
    <div class="rows" id="rows"><div class="empty">Results appear here as each site answers.</div></div>
  </section>
</div>
<p class="foot">“Not found” means the site returned no public profile for that exact handle. “Couldn’t check” means the site blocked or failed the request, so try it by hand. Matching handles are not proof of the same person. Use this only on handles you own or are authorised to research.</p>
</div>
<script>
const $=s=>document.querySelector(s);
let SITES=[], results=[], run=0;

fetch('/api/sites').then(r=>r.json()).then(s=>{SITES=s;buildCats()});

function buildCats(){
  const cats=[...new Set(SITES.map(s=>s.cat))];
  $('#cats').innerHTML=cats.map(c=>`
    <div class="cat" data-cat="${c}">
      <div class="cat-head"><b>${c}</b><button type="button" data-toggle="${c}">Toggle all</button></div>
      <div class="chips">${SITES.filter(s=>s.cat===c).map(s=>`
        <label class="chip"><input type="checkbox" value="${s.id}" checked><span>${s.name}</span></label>`).join('')}
      </div></div>`).join('');
  document.querySelectorAll('[data-toggle]').forEach(b=>b.onclick=()=>{
    const boxes=[...document.querySelectorAll(`[data-cat="${b.dataset.toggle}"] input`)];
    const all=boxes.every(x=>x.checked); boxes.forEach(x=>x.checked=!all);
  });
}

function handle(){
  let v=$('#q').value.trim();
  if(v.includes('@')) v=v.split('@')[0];
  return v;
}

async function search(){
  const u=handle();
  if(!/^[A-Za-z0-9._\-]{1,40}$/.test(u)){
    $('#hint').textContent='Use 1–40 letters, numbers, dots, dashes or underscores.'; return;
  }
  const ids=[...document.querySelectorAll('#cats input:checked')].map(x=>x.value);
  if(!ids.length){ $('#hint').textContent='Select at least one site.'; return; }
  $('#hint').textContent=`Searching for “${u}”`;
  const my=++run; results=[]; $('#csv').disabled=true; $('#go').disabled=true;
  $('#rows').innerHTML=''; $('#prog').style.width='0';
  const sel=SITES.filter(s=>ids.includes(s.id));
  sel.forEach(s=>{
    const d=document.createElement('div'); d.className='row pending'; d.id='r-'+s.id;
    d.innerHTML=`<div class="dot"></div><div><div class="nm">${s.name}</div><div class="meta">Checking…</div></div><div></div>`;
    $('#rows').appendChild(d);
  });
  let done=0;
  const queue=[...sel];
  async function worker(){
    while(queue.length){
      const s=queue.shift(); let r;
      try{ r=await (await fetch(`/api/check?site=${s.id}&u=${encodeURIComponent(u)}`)).json(); }
      catch(e){ r={state:'unknown',why:'request failed',url:''}; }
      if(my!==run) return;
      results.push({site:s.name,cat:s.cat,state:r.state,url:r.url||''});
      paint(s,r); done++;
      $('#prog').style.width=(done/sel.length*100)+'%'; tally();
    }
  }
  await Promise.all(Array.from({length:6},worker));
  if(my===run){ $('#go').disabled=false; $('#csv').disabled=false; tally(true); order(); }
}

function paint(s,r){
  const el=$('#r-'+s.id); const st=r.state;
  el.className='row '+st;
  const label={found:'Profile found',missing:'Not found',unknown:'Couldn’t check'+(r.why?` (${r.why})`:''),link:s.note||'Manual check'}[st];
  const act = st==='found' ? `<a class="open" href="${r.url}" target="_blank" rel="noopener">Open profile</a>`
            : st==='link'  ? `<a class="open" href="${r.url}" target="_blank" rel="noopener">Open search</a>`
            : st==='unknown'? `<a class="open" href="${r.url}" target="_blank" rel="noopener">Try by hand</a>` : '';
  el.innerHTML=`<div class="dot"></div><div><div class="nm">${s.name}</div><div class="meta">${label}</div></div><div>${act}</div>`;
  applyHide();
}
function order(){
  const rank={found:0,unknown:1,link:2,missing:3};
  const box=$('#rows');
  [...box.children].sort((a,b)=>rank[a.className.split(' ')[1]]-rank[b.className.split(' ')[1]]).forEach(n=>box.appendChild(n));
}
function tally(final){
  const f=results.filter(r=>r.state==='found').length;
  const m=results.filter(r=>r.state==='missing').length;
  const o=results.length-f-m;
  $('#tally').innerHTML=`${f} found<small>${m} not found · ${o} need a manual look${final?'':' · running'}</small>`;
}
function applyHide(){
  const h=$('#hide').checked;
  document.querySelectorAll('.row.missing').forEach(r=>r.style.display=h?'none':'');
}
$('#hide').onchange=applyHide;
$('#go').onclick=search;
$('#q').addEventListener('keydown',e=>{ if(e.key==='Enter') search(); });
$('#csv').onclick=()=>{
  const lines=['site,category,result,url',...results.map(r=>[r.site,r.cat,r.state,r.url].map(x=>`"${x}"`).join(','))];
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([lines.join('\n')],{type:'text/csv'}));
  a.download=`handle-hunt-${handle()}.csv`; a.click();
};
</script></body></html>
"""

if __name__ == "__main__":
    host, port = "127.0.0.1", 8765
    print(f"Handle Hunt running at http://{host}:{port}  (Ctrl+C to stop)")
    ThreadingHTTPServer((host, port), Handler).serve_forever()
